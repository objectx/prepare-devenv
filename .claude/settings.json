{
  "permissions": {
    "allow": [
      "Bash(openspec instructions *)",
      "Bash(openspec validate *)",
      "Bash(openspec show *)",
      "Bash(openspec status *)",
      "Bash(cargo --version)",
      "Bash(cargo build *)",
      "Bash(rustc --version)",
      "Bash(rustup show *)",
      "Bash(git --version)",
      "Bash(git status *)",
      "Bash(git log -1 *)",
      "Bash(git diff *)",
      "Bash(git branch --show-current *)",
      "Bash(git rev-parse *)",
      "Bash(git commit *)",
      "Bash(git check-ignore *)",
      "Bash(git worktree *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/cargo-check.ps1"
          }
        ]
      }
    ]
  }
}
